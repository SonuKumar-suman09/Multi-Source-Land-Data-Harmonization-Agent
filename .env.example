# Copy to .env for local development. Never commit .env or real credentials.
APP_ENV=local
APP_NAME=Land Data Harmonization Agent
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173

# Local Docker Compose defaults; rotate before any shared deployment.
POSTGRES_DB=land_harmonizer
POSTGRES_USER=land_app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://land_app:change_me_local_only@127.0.0.1:5433/land_harmonizer
EMBEDDING_DIMENSIONS=768
REDIS_URL=redis://localhost:6379/0

# Generate a unique value for local use. Do not use this example value as a secret.
JWT_SECRET_KEY=replace_with_a_random_secret_before_running_auth
JWT_ACCESS_TOKEN_MINUTES=30

# Provider use is optional; deterministic local mode must work without a key.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local storage paths; uploaded user data is ignored by Git.
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MAX_UPLOAD_MB=100

# Optional observability integrations.
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
